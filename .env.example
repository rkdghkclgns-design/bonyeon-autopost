# 로컬 실행용 설정 예시. 이 파일을 .env 로 복사해 값을 채우세요 (.env 는 git 에 올라가지 않습니다)
# GitHub Actions 에서는 같은 이름으로 Secrets / Variables 에 등록합니다.

# ── 회사 정보 (Variables) ──────────────────────────────
COMPANY_NAME=본연
COMPANY_PHONE=010-0000-0000
# 서비스 지역 (시·도 또는 시·군·구, 쉼표 구분). 글마다 [지역 → 시군구 → 동] 을 돌아가며 키워드로 사용
# 예: 서울,경기,인천,안산  /  비우면 지역명을 쓰지 않음
SERVICE_AREA=서울,경기,인천,안산
DRIVE_ROOT_FOLDER_NAME=청소업체_포스팅자동화

# ── 구글 (Secrets) : scripts/get_google_token.py 로 발급 ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
BLOGGER_BLOG_ID=

# ── Gemini (Secrets) : https://aistudio.google.com/apikey ──
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.5-flash,gemini-3-flash-preview

# ── 슬랙 (Secrets) : 봇 토큰+채널 ID 권장 (영상 업로드 가능). 웹훅만 쓰면 텍스트 알림만 가능 ──
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SLACK_WEBHOOK_URL=

# ── 네이버 블로그 (Secrets) : scripts/export_naver_cookies.py 로 세션 저장 ──
NAVER_BLOG_ID=
NAVER_STORAGE_STATE_B64=
# publish(바로 발행) | draft(임시저장만 — 사람이 확인 후 발행)
NAVER_PUBLISH_MODE=publish

# ── 틱톡 (Secrets) : scripts/get_tiktok_token.py 로 발급 ──
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=
# direct(바로 게시) | inbox(틱톡 앱 받은편지함으로 전송 → 앱에서 최종 게시)
TIKTOK_MODE=direct
# 앱 심사(audit) 전에는 SELF_ONLY(나만 보기)만 가능. 심사 통과 후 PUBLIC_TO_EVERYONE
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# ── 선택: 갱신된 네이버 세션·틱톡 토큰을 GitHub 시크릿에 자동 저장 (fine-grained PAT, Secrets: Read and write) ──
GH_SECRETS_TOKEN=

# ── 동작 옵션 (Variables) ──────────────────────────────
PHOTOS_PER_STAGE=3
# 글마다 넣을 실제 고객후기 캡처 수 (04_고객후기 폴더, 0~3)
REVIEWS_PER_POST=1
MIN_PHOTOS=3
VIDEO_SECONDS=15
OUTPUT_DIR=output
# FONT_PATH=C:/Windows/Fonts/malgunbd.ttf
